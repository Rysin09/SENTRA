# ── Database ────────────────────────────────────────────────────────────────
# SQLite is used by default when this variable is not set (zero-config dev).
# Uncomment and fill in the PostgreSQL URL to use a real database:
# DATABASE_URL=postgresql+psycopg2://sentra:changeme@localhost:5432/sentra_dev
#
# Leave unset to use the local SQLite fallback: sqlite:///./sentra_dev.db

# ── Application ─────────────────────────────────────────────────────────────
# Deployment environment: development | staging | production
SENTRA_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Secret key used for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE

# ── Streamlit ────────────────────────────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501

# ── Reviewer Dashboard (Phase 3) ─────────────────────────────────────────────
# Simple PIN required to access the Reviewer Dashboard.
# In production, this should be replaced with SSO/IAM authentication.
REVIEWER_PIN=1234

# ── OpenAI (Phase 2 — Text Screening) ────────────────────────────────────────
# Required for Phase 2 LLM-powered text screening.
# Obtain your API key from: https://platform.openai.com/api-keys
# NEVER commit this file with a real key. Keep .env in .gitignore.
OPENAI_API_KEY= 

# The OpenAI model to use for text screening.
# The application will validate that the configured model is accessible
# before making screening calls. If unavailable, screening fails safely
# to INSUFFICIENT_DATA with human_review_required=True.
# Example values: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o

# Request timeout in seconds (default: 30)
# OPENAI_TIMEOUT_SECONDS=30

# Maximum retries on transient API errors (default: 2)
# OPENAI_MAX_RETRIES=2

# ── Optional: Audio (Phase 3+) ───────────────────────────────────────────────
# WHISPER_MODEL_SIZE=base
